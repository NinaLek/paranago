{
  "expo": {
    "name": "ParanaGo",
    "slug": "paranago",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "paranago",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B6CA8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paranago.app",
      "infoPlist": {
        "NSCameraUsageDescription": "ParanaGo usa la cámara para leer el QR de la parada y sacar fotos al reportar una demora.",
        "NSLocationWhenInUseUsageDescription": "ParanaGo usa tu ubicación para mostrarte las paradas cercanas.",
        "NSFaceIDUsageDescription": "ParanaGo usa Face ID para volver a ingresar a tu cuenta."
      }
    },
    "android": {
      "package": "com.paranago.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B6CA8"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REEMPLAZAR_CON_TU_API_KEY_DE_GOOGLE_MAPS"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "ParanaGo usa la cámara para leer el QR de la parada y sacar fotos al reportar una demora."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParanaGo usa tu ubicación para mostrarte las paradas cercanas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ParanaGo usa Face ID para volver a ingresar a tu cuenta."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B6CA8"
        }
      ],
      "expo-status-bar",
      "expo-video",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b891854a-f2ce-4057-91ad-ba02be90d548"
      }
    }
  }
}
